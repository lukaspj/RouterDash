<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MikroDash</title>
  <link rel="stylesheet" href="/css/style.css">
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body x-data="dashboard()" x-init="init()">

  <!-- Header -->
  <header class="app-header">
    <div class="app-brand">
      <div class="app-logo">M</div>
      <div class="app-title">Mikro<span class="app-title-accent">Dash</span></div>
    </div>
    <div class="header-right">
      <div class="router-identity" x-show="identity">
        <span>Router:</span>
        <strong x-text="identity"></strong>
        <span class="router-dot" :class="{ offline: !connected }"></span>
      </div>
      <div class="router-identity" x-show="!identity">
        <span class="router-dot offline"></span>
        <span>Disconnected</span>
      </div>
      <button class="btn btn-sm" @click="refreshAll()" :disabled="refreshing">
        <svg :class="{ spinning: refreshing }" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 7a6 6 0 0 1 10.2-4.2M13 7a6 6 0 0 1-10.2 4.2"/>
          <path d="M13 1v4h-4M1 13V9h4"/>
        </svg>
        <span>Refresh</span>
      </button>
    </div>
  </header>

  <!-- Navigation -->
  <nav class="nav-bar">
    <template x-for="(tab, i) in tabs" :key="i">
      <button
        class="nav-tab"
        :class="{ active: activeTab === tab.id }"
        @click="switchTab(tab.id)"
        x-text="tab.label"
      ></button>
    </template>
  </nav>

  <!-- Main Content -->
  <main class="main-content">

    <!------------------------ Overview Section ------------------------>
    <section class="section" :class="{ active: activeTab === 'overview' }" x-show="activeTab === 'overview'">

      <!-- Quick Stats Row -->
      <div class="grid-4">
        <div class="card">
          <div class="card-body">
            <div class="stat-row">
              <div class="stat-icon" style="background: var(--info-bg); color: var(--info);">&#x2194;</div>
              <div>
                <div class="stat-value" x-text="quickStats.interfaces">--</div>
                <div class="stat-label">Interfaces</div>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="stat-row">
              <div class="stat-icon" style="background: var(--success-bg); color: var(--success);">IP</div>
              <div>
                <div class="stat-value" x-text="quickStats.addresses">--</div>
                <div class="stat-label">IP Addresses</div>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="stat-row">
              <div class="stat-icon" style="background: var(--warning-bg); color: var(--warning);">DH</div>
              <div>
                <div class="stat-value" x-text="quickStats.dhcpLeases">--</div>
                <div class="stat-label">DHCP Leases</div>
              </div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-body">
            <div class="stat-row">
              <div class="stat-icon" style="background: var(--danger-bg); color: var(--danger);">FW</div>
              <div>
                <div class="stat-value" x-text="quickStats.firewallRules">--</div>
                <div class="stat-label">Firewall Rules</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- System Info + Resources -->
      <div class="grid-2">
        <!-- System Info -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">System Information</span>
          </div>
          <div class="card-body" x-show="!systemLoading && !systemError">
            <div class="info-grid">
              <div class="info-item">
                <div class="info-item-label">Identity</div>
                <div class="info-item-value" x-text="system.identity || '--'">--</div>
              </div>
              <div class="info-item">
                <div class="info-item-label">Version</div>
                <div class="info-item-value" x-text="system.version || '--'">--</div>
              </div>
              <div class="info-item">
                <div class="info-item-label">Architecture</div>
                <div class="info-item-value" x-text="system.architecture || '--'">--</div>
              </div>
              <div class="info-item">
                <div class="info-item-label">Board</div>
                <div class="info-item-value" x-text="system.boardName || '--'">--</div>
              </div>
              <div class="info-item">
                <div class="info-item-label">Uptime</div>
                <div class="info-item-value" x-text="system.uptime || '--'">--</div>
              </div>
              <div class="info-item">
                <div class="info-item-label">Platform</div>
                <div class="info-item-value" x-text="system.platform || '--'">--</div>
              </div>
            </div>
            <template x-if="!hardwareLoading && !hardwareError && Object.keys(hardware).length">
              <div class="hw-section">
                <div class="hw-section-label">Hardware Sensors</div>
                <div class="hw-pills">
                  <template x-if="hardware.temp">
                    <span class="hw-pill">
                      <span class="hw-pill-icon">&#x1F321;</span>
                      <span x-text="hardware.temp"></span>
                    </span>
                  </template>
                  <template x-if="hardware.boardTemp">
                    <span class="hw-pill">
                      <span class="hw-pill-icon">&#x1F4CC;</span>
                      <span x-text="hardware.boardTemp"></span>
                    </span>
                  </template>
                  <template x-if="hardware.voltage">
                    <span class="hw-pill">
                      <span class="hw-pill-icon">&#x26A1;</span>
                      <span x-text="hardware.voltage"></span>
                    </span>
                  </template>
                  <template x-if="hardware.fan">
                    <span class="hw-pill">
                      <span class="hw-pill-icon">&#x1F32C;</span>
                      <span x-text="hardware.fan"></span>
                    </span>
                  </template>
                </div>
                <template x-if="hardware.model || hardware.serial || hardware.firmware || hardware.memory">
                  <div class="hw-details">
                    <div class="hw-detail-grid">
                      <template x-if="hardware.model">
                        <div class="hw-detail">
                          <span class="hw-detail-label">Model</span>
                          <span class="hw-detail-val" x-text="hardware.model"></span>
                        </div>
                      </template>
                      <template x-if="hardware.serial">
                        <div class="hw-detail">
                          <span class="hw-detail-label">Serial</span>
                          <span class="hw-detail-val hw-mono" x-text="hardware.serial"></span>
                        </div>
                      </template>
                      <template x-if="hardware.firmware">
                        <div class="hw-detail">
                          <span class="hw-detail-label">Firmware</span>
                          <span class="hw-detail-val hw-mono" x-text="hardware.firmware"></span>
                        </div>
                      </template>
                      <template x-if="hardware.memory">
                        <div class="hw-detail">
                          <span class="hw-detail-label">RAM</span>
                          <span class="hw-detail-val hw-mono" x-text="hardware.memory"></span>
                        </div>
                      </template>
                      <template x-if="hardware.storage">
                        <div class="hw-detail">
                          <span class="hw-detail-label">Storage</span>
                          <span class="hw-detail-val hw-mono" x-text="hardware.storage"></span>
                        </div>
                      </template>
                    </div>
                  </div>
                </template>
              </div>
            </template>
          </div>
          <div class="loading-state" x-show="systemLoading">
            <div class="loading-spinner"></div>
            <span>Loading system info...</span>
          </div>
          <div class="error-state" x-show="systemError">
            <span>Failed to load</span>
            <span class="error-message" x-text="systemError"></span>
            <button class="btn btn-sm retry-btn" @click="fetchSystem()">Retry</button>
          </div>
        </div>

        <!-- Resource Gauges -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">Resource Usage</span>
          </div>
          <div class="card-body" x-show="!resourcesLoading && !resourcesError">
            <div class="gauge">
              <div class="gauge-header">
                <span class="gauge-label">CPU Load</span>
                <span class="gauge-value" x-text="resources.cpu + '%'" :class="{ 'text-danger': resources.cpu > 80, 'text-warning': resources.cpu > 60 && resources.cpu <= 80 }">--%</span>
              </div>
              <div class="gauge-track">
                <div class="gauge-fill cpu" :class="{ critical: resources.cpu > 80 }"
                     :style="{ width: resources.cpu + '%' }"></div>
              </div>
            </div>
            <div class="gauge">
              <div class="gauge-header">
                <span class="gauge-label">Free Memory</span>
                <span class="gauge-value" x-text="resources.freeMemory + '%'">--%</span>
              </div>
              <div class="gauge-track">
                <div class="gauge-fill memory" :class="{ critical: resources.freeMemory < 20 }"
                     :style="{ width: resources.freeMemory + '%' }"></div>
              </div>
            </div>
            <div class="gauge">
              <div class="gauge-header">
                <span class="gauge-label">Free HDD</span>
                <span class="gauge-value" x-text="resources.freeHdd + '%'">--%</span>
              </div>
              <div class="gauge-track">
                <div class="gauge-fill disk" :class="{ critical: resources.freeHdd < 20 }"
                     :style="{ width: resources.freeHdd + '%' }"></div>
              </div>
            </div>
          </div>
          <div class="loading-state" x-show="resourcesLoading">
            <div class="loading-spinner"></div>
            <span>Loading resources...</span>
          </div>
          <div class="error-state" x-show="resourcesError">
            <span>Failed to load</span>
            <span class="error-message" x-text="resourcesError"></span>
            <button class="btn btn-sm retry-btn" @click="fetchResources()">Retry</button>
          </div>
        </div>
      </div>
    </section>

    <!------------------------ Interfaces Section ------------------------>
    <section class="section" :class="{ active: activeTab === 'interfaces' }" x-show="activeTab === 'interfaces'">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Interfaces</span>
          <span class="text-muted" style="font-size:12px" x-show="interfaces.length">
            <span x-text="interfaces.length"></span> total
          </span>
        </div>
        <div class="port-grid" x-show="!interfacesLoading && !interfacesError && interfaces.length">
          <template x-for="iface in portInterfaces" :key="iface.name || iface['.id']">
            <div class="port-card"
                 :class="{
                   'port-up': iface.running === 'true' || (iface.disabled === 'false' && iface.running !== 'false'),
                   'port-down': !(iface.running === 'true' || (iface.disabled === 'false' && iface.running !== 'false')),
                   'pt-ether': (/^ether/i.test(iface.type) || (/^ether/i.test(iface.name) && !/wireguard|wlan|wireless|bridge|vlan|bond|tunnel|ppp|l2tp|pptp|sstp|ovpn|gre|eoip|ipip|loopback|lo$|vrrp/i.test(iface.type||''))),
                   'pt-wlan': (/wireless|wlan/i.test(iface.type) || /wlan/i.test(iface.name)),
                   'pt-wg': (/wireguard|wg$/i.test(iface.type) || /wireguard|wg$/i.test(iface.name)),
                   'pt-bridge': (/^bridge/i.test(iface.type) || /^bridge/i.test(iface.name)),
                   'pt-vlan': (/^vlan/i.test(iface.type) || /^vlan/i.test(iface.name)),
                   'pt-bond': (/bond/i.test(iface.type) || /bond/i.test(iface.name)),
                   'pt-tunnel': (/tunnel|ppp|l2tp|pptp|sstp|ovpn|gre|eoip|ipip/i.test(iface.type) || /tunnel|ppp|vpn/i.test(iface.name)),
                   'pt-loopback': (/loopback|lo$/i.test(iface.type) || /^lo$/i.test(iface.name)),
                   'pt-vrrp': (/vrrp/i.test(iface.type) || /vrrp/i.test(iface.name))
                 }">
              <div class="port-top">
                <span class="port-type" x-text="iface.type || 'ether'"></span>
                <span class="port-dot" :class="iface.running === 'true' || (iface.disabled === 'false' && iface.running !== 'false') ? 'up' : 'down'"></span>
              </div>
              <div class="port-name" x-text="iface.name || iface['.id']"></div>
              <div class="port-mac" x-text="iface['mac-address'] || ''"></div>
              <div class="port-traffic">
                <div class="port-traffic-row">
                  <span class="port-traffic-label">RX</span>
                  <span class="port-traffic-val" x-text="formatBytes(iface['rx-byte'])"></span>
                </div>
                <div class="port-traffic-row">
                  <span class="port-traffic-label">TX</span>
                  <span class="port-traffic-val" x-text="formatBytes(iface['tx-byte'])"></span>
                </div>
              </div>
            </div>
          </template>
        </div>
        <div class="loading-state" x-show="interfacesLoading">
          <div class="loading-spinner"></div>
          <span>Loading interfaces...</span>
        </div>
        <!-- Bridge groups -->
        <template x-if="bridgePorts.length">
          <div class="bridge-groups">
            <template x-for="(members, bridge) in bridgeGroups" :key="bridge">
              <div class="bridge-group" :class="members.running ? 'bg-up' : 'bg-down'">
                <div class="bridge-header">
                  <span class="bridge-icon">&#x2395;</span>
                  <span x-text="members.bridge"></span>
                  <span class="text-muted" style="font-size:10px">bridge</span>
                </div>
                <div class="bridge-members">
                  <template x-for="m in members.members" :key="m">
                    <span class="bridge-member" x-text="m"></span>
          </template>
        </div>
        <div class="port-traffic">
                  <div class="port-traffic-row">
                    <span class="port-traffic-label">RX</span>
                    <span class="port-traffic-val" x-text="formatBytes(members.rx)"></span>
                  </div>
                  <div class="port-traffic-row">
                    <span class="port-traffic-label">TX</span>
                    <span class="port-traffic-val" x-text="formatBytes(members.tx)"></span>
                  </div>
                </div>
              </div>
            </template>
          </div>
        </template>
        <!-- Ethernet interfaces -->
        <template x-if="ethernetInterfaces.length">
          <div class="eth-section">
            <div class="eth-section-title">Ethernet Ports</div>
            <div class="eth-grid">
              <template x-for="eth in ethernetInterfaces" :key="eth['.id']">
                <div class="eth-card" :class="eth.running === 'true' ? 'eth-up' : 'eth-down'">
                  <div class="eth-header">
                    <span class="eth-name"><span class="eth-dot" :class="eth.running === 'true' ? 'eth-dot-up' : 'eth-dot-down'"></span><span x-text="eth.name || eth['default-name'] || eth['.id']"></span></span>
                    <span class="eth-status" :class="eth.running === 'true' ? 'eth-status-up' : 'eth-status-down'" x-text="eth.running === 'true' ? 'up' : 'down'"></span>
                  </div>
                  <div class="eth-details">
                    <template x-if="eth.speed">
                      <div class="eth-row">
                        <span class="eth-label">Speed</span>
                        <span class="eth-val eth-speed" x-text="eth.speed"></span>
                      </div>
                    </template>
                    <div class="eth-row">
                      <span class="eth-label">MAC</span>
                      <span class="eth-val" x-text="eth['mac-address'] || '--'"></span>
                    </div>
                    <template x-if="eth['sfp-vendor-name']">
                      <div class="eth-row">
                        <span class="eth-label">SFP</span>
                        <span class="eth-val" x-text="eth['sfp-vendor-name'] + ' ' + (eth['sfp-vendor-part-number'] || '')"></span>
                      </div>
                    </template>
                    <template x-if="eth['poe-out'] && eth['poe-out'] !== 'off'">
                      <div class="eth-row">
                        <span class="eth-label">PoE</span>
                        <span class="eth-val eth-poe" x-text="eth['poe-out']"></span>
                      </div>
                    </template>
                    <div class="eth-traffic">
                      <div class="eth-traffic-row">
                        <span class="eth-traffic-label">RX</span>
                        <span class="eth-traffic-val" x-text="formatBytes(eth['rx-byte'] || 0)"></span>
                      </div>
                      <div class="eth-traffic-row">
                        <span class="eth-traffic-label">TX</span>
                        <span class="eth-traffic-val" x-text="formatBytes(eth['tx-byte'] || 0)"></span>
                      </div>
                    </div>
                  </div>
                </div>
              </template>
            </div>
          </div>
        </template>
        <div class="error-state" x-show="interfacesError">
          <span>Failed to load interfaces</span>
          <span class="error-message" x-text="interfacesError"></span>
          <button class="btn btn-sm retry-btn" @click="fetchInterfaces()">Retry</button>
        </div>
        <div class="empty-state" x-show="!interfacesLoading && !interfacesError && !interfaces.length">
          <span>No interfaces found</span>
        </div>
      </div>
    </section>

    <!------------------------ DHCP Section ------------------------>
    <section class="section" :class="{ active: activeTab === 'dhcp' }" x-show="activeTab === 'dhcp'">
      <div class="card">
        <div class="card-header">
          <span class="card-title">DHCP Leases</span>
          <span class="text-muted" style="font-size:12px" x-show="dhcpLeases.length">
            <span x-text="dhcpLeases.length"></span> leases
          </span>
        </div>
        <div class="table-wrap" x-show="!dhcpLoading && !dhcpError && dhcpLeases.length">
          <table>
            <thead>
              <tr>
                <th>IP Address</th>
                <th>MAC Address</th>
                <th>Hostname</th>
                <th>Server</th>
                <th>Status</th>
                <th>Expires After</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="lease in dhcpLeases" :key="lease['.id'] || lease['mac-address']">
                <tr>
                  <td class="mono" x-text="lease['address'] || lease['active-address'] || '--'"></td>
                  <td class="mono" x-text="lease['mac-address'] || '--'"></td>
                  <td x-text="lease['host-name'] || lease['comment'] || '--'"></td>
                  <td x-text="lease['server'] || '--'"></td>
                  <td>
                    <span class="badge" :class="lease['status'] === 'bound' ? 'badge-success' : (lease['status'] === 'offered' ? 'badge-warning' : 'badge-mono')"
                          x-text="lease['status'] || '--'"></span>
                  </td>
                  <td class="mono text-muted" x-text="lease['expires-after'] || '--'"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <div class="loading-state" x-show="dhcpLoading">
          <div class="loading-spinner"></div>
          <span>Loading DHCP leases...</span>
        </div>
        <div class="error-state" x-show="dhcpError">
          <span>Failed to load DHCP leases</span>
          <span class="error-message" x-text="dhcpError"></span>
          <button class="btn btn-sm retry-btn" @click="fetchDhcp()">Retry</button>
        </div>
        <div class="empty-state" x-show="!dhcpLoading && !dhcpError && !dhcpLeases.length">
          <span>No DHCP leases found</span>
        </div>
      </div>
    </section>

    <!------------------------ Firewall Section ------------------------>
    <section class="section" :class="{ active: activeTab === 'firewall' }" x-show="activeTab === 'firewall'">
      <div class="card">
        <div class="card-header">
          <span class="card-title">
            Firewall
            <span x-show="fwView === 'topology'">Topology</span>
            <span x-show="fwView === 'flow'">Chain Flow</span>
          </span>
          <span class="text-muted" style="font-size:12px" x-show="firewallRules.length">
            <span x-text="firewallRules.length"></span> rules
            <span x-show="fwView === 'topology'">
              &middot; <span x-text="fwGraph.nodes.length"></span> zones
              &middot; <span x-text="fwGraph.edges.length"></span> flows
            </span>
          </span>
        </div>
        <!-- View toggle -->
        <div class="fw-legend">
          <div class="fw-toggle">
            <button :class="'fw-toggle-btn ' + (fwView === 'topology' ? 'active' : '')" @click="fwView = 'topology'">Topology</button>
            <button :class="'fw-toggle-btn ' + (fwView === 'flow' ? 'active' : '')" @click="fwView = 'flow'">Chain Flow</button>
          </div>
          <template x-if="fwView === 'flow'">
            <div class="fw-chain-tabs">
              <template x-for="ch in fwChains" :key="ch">
                <button :class="'fw-toggle-btn ' + (fwChain === ch ? 'active' : '')" @click="fwChain = ch" x-text="ch"></button>
              </template>
            </div>
          </template>
          <span class="fw-legend-item"><span class="fw-legend-swatch accept"></span> Accept</span>
          <span class="fw-legend-item"><span class="fw-legend-swatch drop"></span> Drop</span>
          <span class="fw-legend-item"><span class="fw-legend-swatch reject"></span> Reject</span>
          <span class="fw-legend-item"><span class="fw-legend-swatch passthrough"></span> Passthrough</span>
          <span class="fw-legend-item"><span class="fw-legend-swatch fasttrack"></span> FastTrack</span>
          <span x-show="fwView === 'topology'">
            <span class="fw-legend-item"><span class="fw-legend-sep">|</span></span>
            <span class="fw-legend-item"><span class="fw-legend-dot vlan"></span> VLAN</span>
            <span class="fw-legend-item"><span class="fw-legend-dot iface"></span> Interface</span>
            <span class="fw-legend-item"><span class="fw-legend-dot net"></span> Network</span>
          </span>
        </div>
        <!-- Topology view -->
        <div class="fw-graph-wrap" x-show="!firewallLoading && !firewallError && fwGraph.nodes.length && fwView === 'topology'" x-html="fwGraphSvg"></div>
        <!-- Chain flow view -->
        <div class="fw-graph-wrap" x-show="!firewallLoading && !firewallError && fwChainRules.length && fwView === 'flow'" x-html="fwChainFlow"></div>
        <div class="empty-state" x-show="!firewallLoading && !firewallError && !fwChainRules.length && fwView === 'flow'">
          <span x-text="'No rules in ' + fwChain + ' chain'"></span>
        </div>
        <!-- Rule table -->
        <div class="fw-table-wrap" x-show="!firewallLoading && !firewallError && firewallRules.length && fwView !== 'flow'">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Chain</th>
                <th>Action</th>
                <th>In Interface</th>
                <th>Out Interface</th>
                <th>Src Address</th>
                <th>Dst Address</th>
                <th>Proto</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="(rule, idx) in firewallRules" :key="rule['.id'] || idx">
                <tr>
                  <td class="text-muted" x-text="idx + 1"></td>
                  <td><span class="badge" :class="rule.chain === 'input' ? 'badge-info' : (rule.chain === 'forward' ? 'badge-warning' : (rule.chain === 'output' ? 'badge-success' : 'badge-mono'))" x-text="rule.chain || '--'"></span></td>
                  <td><span class="badge" :class="rule.action === 'accept' ? 'badge-success' : (rule.action === 'drop' ? 'badge-danger' : 'badge-warning')" x-text="rule.action || '--'"></span></td>
                  <td class="mono" x-text="rule['in-interface'] || 'any'"></td>
                  <td class="mono" x-text="rule['out-interface'] || 'any'"></td>
                  <td class="mono" x-text="rule['src-address'] || 'any'"></td>
                  <td class="mono" x-text="rule['dst-address'] || 'any'"></td>
                  <td x-text="rule.protocol || 'any'"></td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <div class="loading-state" x-show="firewallLoading">
          <div class="loading-spinner"></div>
          <span>Loading firewall rules...</span>
        </div>
        <div class="error-state" x-show="firewallError">
          <span>Failed to load firewall rules</span>
          <span class="error-message" x-text="firewallError"></span>
          <button class="btn btn-sm retry-btn" @click="fetchFirewall()">Retry</button>
        </div>
        <div class="empty-state" x-show="!firewallLoading && !firewallError && !firewallRules.length">
          <span>No firewall rules found</span>
        </div>
      </div>
    </section>

    <!------------------------ Wireless Section ------------------------>
    <section class="section" :class="{ active: activeTab === 'wireless' }" x-show="activeTab === 'wireless'">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Wireless Interfaces</span>
          <span class="text-muted" style="font-size:12px" x-show="wirelessInterfaces.length">
            <span x-text="wirelessInterfaces.length"></span> interfaces
          </span>
        </div>
        <div class="table-wrap" x-show="!wirelessLoading && !wirelessError && wirelessInterfaces.length">
          <table>
            <thead>
              <tr>
                <th>Name</th>
                <th>SSID</th>
                <th>Band</th>
                <th>Frequency</th>
                <th>Channel</th>
                <th>Status</th>
                <th class="text-right">Clients</th>
              </tr>
            </thead>
            <tbody>
              <template x-for="wlan in wirelessInterfaces" :key="wlan['.id'] || wlan.name">
                <tr>
                  <td><strong x-text="wlan.name || wlan['.id']"></strong></td>
                  <td x-text="wlan.ssid || '--'"></td>
                  <td x-text="wlan.band || '--'"></td>
                  <td class="mono" x-text="wlan.frequency ? wlan.frequency + ' MHz' : '--'"></td>
                  <td x-text="wlan.channel || wlan['current-channel'] || '--'"></td>
                  <td>
                    <span class="status">
                      <span class="status-dot" :class="wlan.disabled === 'false' || wlan.running === 'true' ? 'running' : 'disabled'"></span>
                      <span x-text="wlan.disabled === 'false' || wlan.running === 'true' ? 'Running' : 'Disabled'"></span>
                    </span>
                  </td>
                  <td class="text-right">
                    <span class="badge" :class="(wlan['registered-clients'] || wlan['client-count'] || 0) > 0 ? 'badge-info' : 'badge-mono'"
                          x-text="wlan['registered-clients'] || wlan['client-count'] || 0"></span>
                  </td>
                </tr>
              </template>
            </tbody>
          </table>
        </div>
        <div class="loading-state" x-show="wirelessLoading">
          <div class="loading-spinner"></div>
          <span>Loading wireless interfaces...</span>
        </div>
        <div class="error-state" x-show="wirelessError">
          <span>Failed to load wireless interfaces</span>
          <span class="error-message" x-text="wirelessError"></span>
          <button class="btn btn-sm retry-btn" @click="fetchWireless()">Retry</button>
        </div>
        <div class="empty-state" x-show="!wirelessLoading && !wirelessError && !wirelessInterfaces.length">
          <span>No wireless interfaces found</span>
        </div>
      </div>
    </section>

  </main>

  <!-- Refresh status bar -->
  <div class="refresh-bar">
    <span>Auto-refresh every 30s</span>
    &middot;
    <span>
      Last updated:
      <span x-text="lastRefresh || 'never'" class="mono"></span>
    </span>
    &middot;
    <span class="status" x-show="refreshing">
      <span class="status-dot running"></span>
      Refreshing...
    </span>
    <span class="status" x-show="!refreshing && lastRefresh">
      <span class="status-dot running"></span>
      Connected
    </span>
  </div>

  <!-- AlpineJS App -->
  <script>
  function dashboard() {
    return {
      // --- UI State ---
      activeTab: 'overview',
      tabs: [
        { id: 'overview', label: 'Overview' },
        { id: 'interfaces', label: 'Interfaces' },
        { id: 'dhcp', label: 'DHCP' },
        { id: 'firewall', label: 'Firewall' },
        { id: 'wireless', label: 'Wireless' },
      ],
      refreshing: false,
      connected: false,
      lastRefresh: null,
      _interval: null,

      // --- Data ---
      identity: '',
      system: {},
      resources: { cpu: 0, freeMemory: 0, freeHdd: 0 },
      resourcesFetched: false,
      quickStats: { interfaces: 0, addresses: 0, dhcpLeases: 0, firewallRules: 0 },
      interfaces: [],
      dhcpLeases: [],
      firewallRules: [],
      fwGraph: { nodes: [], edges: [] },
      fwView: 'topology',
      fwChain: 'forward',
      wirelessInterfaces: [],
      bridgePorts: [],
      ethernetInterfaces: [],
      hardware: {},
      hardwareLoading: true,
      hardwareError: '',

      // --- Loading/Error per section ---
      systemLoading: true,
      systemError: '',
      resourcesLoading: true,
      resourcesError: '',
      interfacesLoading: true,
      interfacesError: '',
      dhcpLoading: true,
      dhcpError: '',
      firewallLoading: true,
      firewallError: '',
      wirelessLoading: true,
      wirelessError: '',
      ethernetLoading: true,
      ethernetError: '',

      // --- Init ---
      init() {
        const saved = localStorage.getItem('mikrodash-tab');
        if (saved && this.tabs.some(t => t.id === saved)) this.activeTab = saved;
        this.refreshAll();
        this._interval = setInterval(() => { this.refreshAll(); }, 30000);
      },

      // --- Tab switching ---
      switchTab(tabId) {
        this.activeTab = tabId;
        localStorage.setItem('mikrodash-tab', tabId);
      },

      // --- Refresh all data ---
      async refreshAll() {
        this.refreshing = true;
        try {
          await Promise.all([
            this.fetchSystem(),
            this.fetchResources(),
          ]);
          // Fire section fetches based on active tab priority, but do all
    const results = await Promise.allSettled([
      this.fetchInterfaces(),
      this.fetchDhcp(),
      this.fetchFirewall(),
      this.fetchWireless(),
      this.fetchHardware(),
    ]);
          this.connected = true;
          this.lastRefresh = new Date().toLocaleTimeString();
        } catch (e) {
          // connectivity check already handled in each fetch
        }
        this.refreshing = false;
      },

      // --- API helper ---
      async apiFetch(endpoint) {
        try {
          const res = await fetch(endpoint);
          if (!res.ok) {
            throw new Error(`HTTP ${res.status}: ${res.statusText}`);
          }
          return await res.json();
        } catch (err) {
          throw err;
        }
      },

      // --- System ---
      async fetchSystem() {
        const hasData = Object.keys(this.system).length > 0;
        if (!hasData) { this.systemLoading = true; this.systemError = ''; }
        try {
          const data = await this.apiFetch('/api/system/resource');
          const idData = await this.apiFetch('/api/system/identity').catch(() => ({}));

          this.system = {
            identity: idData.name || idData.identity || '',
            version: data.version || '',
            architecture: data['architecture-name'] || '',
            boardName: data['board-name'] || '',
            uptime: this.formatUptime(data.uptime),
            platform: data.platform || '',
          };
          this.identity = this.system.identity;
          this.connected = true;
        } catch (err) {
          if (!hasData) { this.systemError = err.message || 'Unable to reach API'; }
          this.connected = false;
        }
        if (!hasData) { this.systemLoading = false; }
      },

      // --- Resources ---
      async fetchResources() {
        const hasData = this.resourcesFetched;
        if (!hasData) { this.resourcesLoading = true; this.resourcesError = ''; }
        try {
          const data = await this.apiFetch('/api/system/resource');
          this.resources = {
            cpu: Math.round(parseFloat(data['cpu-load']) || 0),
            freeMemory: Math.round(parseFloat(data['free-memory']) / parseFloat(data['total-memory']) * 100) || 0,
            freeHdd: Math.round(parseFloat(data['free-hdd-space']) / parseFloat(data['total-hdd-space']) * 100) || 0,
          };
          this.resourcesFetched = true;
        } catch (err) {
          if (!hasData) { this.resourcesError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.resourcesLoading = false; }
      },

      // --- Hardware ---
      async fetchHardware() {
        const hasData = Object.keys(this.hardware).length > 0;
        if (!hasData) { this.hardwareLoading = true; this.hardwareError = ''; }
        try {
          const [healthData, rbData] = await Promise.all([
            this.apiFetch('/api/system/health').catch(() => []),
            this.apiFetch('/api/system/routerboard').catch(() => ({})),
          ]);
          const hw = {};
          for (const s of Array.isArray(healthData) ? healthData : []) {
            const n = (s.name || '').toLowerCase();
            if (n === 'temperature' || n.includes('cpu-temp')) hw.temp = s.value + '\u00b0C';
            else if (n.includes('board-temp')) hw.boardTemp = s.value + '\u00b0C';
            else if (n.includes('temp') && !hw.temp) hw.temp = s.value + '\u00b0C';
            if (n === 'voltage') hw.voltage = s.value + 'V';
            if (n === 'current') hw.current = s.value + 'A';
            if (n.includes('fan') || n.includes('rpm')) hw.fan = (hw.fan ? hw.fan + ', ' : '') + s.value + ' RPM';
          }
          if (!hw.temp && hw.boardTemp) hw.temp = hw.boardTemp;
          hw.model = rbData.model || rbData['board-name'] || '';
          hw.serial = rbData['serial-number'] || '';
          hw.firmware = rbData['current-firmware'] || '';
          hw.memory = rbData['memory'] ? rbData.memory + ' MB' : '';
          hw.storage = rbData['nand-size'] || rbData['storage-size'] || '';
          this.hardware = hw;
        } catch (err) {
          if (!hasData) { this.hardwareError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.hardwareLoading = false; }
      },

      // --- Interfaces ---
      async fetchInterfaces() {
        const hasData = this.interfaces.length > 0;
        if (!hasData) { this.interfacesLoading = true; this.interfacesError = ''; }
        try {
          this.interfaces = await this.apiFetch('/api/interface');
          this.quickStats.interfaces = this.interfaces.length;
          this.fetchBridgePorts();
          this.fetchEthernet();
        } catch (err) {
          if (!hasData) { this.interfacesError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.interfacesLoading = false; }
      },

      async fetchBridgePorts() {
        try { this.bridgePorts = await this.apiFetch('/api/interface/bridge/port'); }
        catch { this.bridgePorts = []; }
      },

      async fetchEthernet() {
        try { this.ethernetInterfaces = await this.apiFetch('/api/interface/ethernet'); }
        catch { this.ethernetInterfaces = []; }
      },

      get portInterfaces() {
        return this.interfaces.filter(i => !/^bridge/i.test(i.type) && !/^bridge/i.test(i.name));
      },

      get bridgeGroups() {
        const ifaceMap = {};
        for (const i of this.interfaces) { ifaceMap[i.name] = i; }
        const map = {};
        for (const bp of this.bridgePorts) {
          const br = bp.bridge || 'unknown';
          if (!map[br]) map[br] = [];
          map[br].push(bp.interface || bp['.id']);
        }
        return Object.entries(map).map(([bridge, members]) => {
          const bi = ifaceMap[bridge] || {};
          return {
            bridge,
            members,
            rx: bi['rx-byte'] || '0',
            tx: bi['tx-byte'] || '0',
            running: bi.running === 'true' || bi.disabled === 'false'
          };
        });
      },

      // --- DHCP ---
      async fetchDhcp() {
        const hasData = this.dhcpLeases.length > 0;
        if (!hasData) { this.dhcpLoading = true; this.dhcpError = ''; }
        try {
          this.dhcpLeases = await this.apiFetch('/api/ip/dhcp-server/lease');
          this.quickStats.dhcpLeases = this.dhcpLeases.length;
        } catch (err) {
          if (!hasData) { this.dhcpError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.dhcpLoading = false; }
      },

      // --- Firewall ---
      async fetchFirewall() {
        const hasData = this.firewallRules.length > 0;
        if (!hasData) { this.firewallLoading = true; this.firewallError = ''; }
        try {
          this.firewallRules = await this.apiFetch('/api/ip/firewall/filter');
          this.quickStats.firewallRules = this.firewallRules.length;
          this.buildFirewallGraph();
        } catch (err) {
          if (!hasData) { this.firewallError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.firewallLoading = false; }
      },

      buildFirewallGraph() {
        const rules = this.firewallRules;
        const interfaces = new Set();
        const networks = new Set();

        for (const r of rules) {
          if (r['in-interface'] && r['in-interface'] !== 'all') interfaces.add(r['in-interface']);
          if (r['out-interface'] && r['out-interface'] !== 'all') interfaces.add(r['out-interface']);
          const src = r['src-address'];
          const dst = r['dst-address'];
          if (src && src !== '0.0.0.0/0' && src.includes('/')) networks.add(src);
          if (dst && dst !== '0.0.0.0/0' && dst.includes('/')) networks.add(dst);
        }

        const nodes = [];
        nodes.push({ id: 'router', label: this.identity || 'Router', type: 'router', x: 200, y: 150 });

        const cx = 200, cy = 150, ifaceR = 70, netR = 130;
        const ifaceArr = [...interfaces];
        ifaceArr.forEach((name, i) => {
          const a = (i / ifaceArr.length) * 2 * Math.PI - Math.PI / 2;
          const isVlan = /^vlan\d+$/i.test(name) || name.toLowerCase().includes('vlan');
          nodes.push({ id: 'iface:' + name, label: name, type: isVlan ? 'vlan' : 'interface', x: cx + ifaceR * Math.cos(a), y: cy + ifaceR * Math.sin(a) });
        });

        const netArr = [...networks];
        netArr.forEach((net, i) => {
          const a = (i / netArr.length) * 2 * Math.PI - Math.PI / 2;
          nodes.push({ id: 'net:' + net, label: net, type: 'network', x: cx + netR * Math.cos(a), y: cy + netR * Math.sin(a) });
        });

        const nodeMap = {};
        nodes.forEach(n => { nodeMap[n.id] = n; });

        const edgeMap = new Map();
        for (const r of rules) {
          const srcI = r['in-interface'];
          const dstI = r['out-interface'];
          const srcN = r['src-address'];
          const dstN = r['dst-address'];

          let srcId = 'router', dstId = 'router';
          if (srcI && srcI !== 'all') srcId = 'iface:' + srcI;
          else if (srcN && srcN !== '0.0.0.0/0' && srcN.includes('/')) srcId = 'net:' + srcN;
          if (dstI && dstI !== 'all') dstId = 'iface:' + dstI;
          else if (dstN && dstN !== '0.0.0.0/0' && dstN.includes('/')) dstId = 'net:' + dstN;
          if (srcId === dstId) continue;

          const srcN2 = nodeMap[srcId], dstN2 = nodeMap[dstId];
          if (!srcN2 || !dstN2) continue;

          const key = srcId + '|' + dstId + '|' + (r.action || 'accept');
          if (edgeMap.has(key)) {
            edgeMap.get(key).rules.push(r);
          } else {
            edgeMap.set(key, {
              id: key,
              from: srcId, to: dstId,
              action: r.action || 'accept',
              chain: r.chain || 'forward',
              srcX: srcN2.x, srcY: srcN2.y,
              dstX: dstN2.x, dstY: dstN2.y,
              rules: [r],
            });
          }
        }
        this.fwGraph = { nodes, edges: [...edgeMap.values()] };
      },

      get fwGraphSvg() {
        const g = this.fwGraph;
        if (!g.nodes.length) return '';
        const esc = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        let svg = '<svg viewBox="0 0 400 300" class="fw-svg">';
        svg += '<defs>';
        svg += '<marker id="arr-accept" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#22c55e"/></marker>';
        svg += '<marker id="arr-drop" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#ef4444"/></marker>';
        svg += '<marker id="arr-reject" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#f59e0b"/></marker>';
        svg += '<marker id="arr-passthrough" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#3b82f6"/></marker>';
        svg += '<marker id="arr-fasttrack-connection" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#14b8a6"/></marker>';
        svg += '</defs>';
        for (const e of g.edges) {
          const tip = esc(e.action.toUpperCase() + ' | ' + e.chain + ' chain\n' +
            e.rules.map(r => (r['src-address']||'any') + ' → ' + (r['dst-address']||'any') + (r.protocol ? ' (' + r.protocol + ')' : '')).join('\n'));
          svg += `<g class="fw-edge-group"><line x1="${e.srcX}" y1="${e.srcY}" x2="${e.dstX}" y2="${e.dstY}" class="fw-edge ${e.action}" marker-end="url(#arr-${e.action})"/><title>${tip}</title></g>`;
        }
        for (const n of g.nodes) {
          const r = n.type === 'router' ? 12 : 9;
          const labelY = n.type === 'router' ? n.y + 18 : n.y + 14;
          svg += `<g class="fw-node-group"><circle cx="${n.x}" cy="${n.y}" r="${r}" class="fw-node ${n.type}"/><text x="${n.x}" y="${labelY}" class="fw-node-text" text-anchor="middle">${esc(n.label)}</text></g>`;
        }
        svg += '</svg>';
        return svg;
      },

      get fwChains() {
        const chains = new Set();
        this.firewallRules.forEach(r => { if (r.chain) chains.add(r.chain); });
        return [...chains].sort();
      },

      get fwChainRules() {
        return this.firewallRules.filter(r => (r.chain || 'forward') === this.fwChain);
      },

      get fwChainFlow() {
        const rules = this.fwChainRules;
        if (!rules.length) return '';
        const esc = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        const fmtBytes = (b) => {
          const n = parseInt(b);
          if (!n) return '0 B';
          if (n >= 1e9) return (n/1e9).toFixed(1)+' GB';
          if (n >= 1e6) return (n/1e6).toFixed(1)+' MB';
          if (n >= 1e3) return (n/1e3).toFixed(1)+' KB';
          return n+' B';
        };
        const fmtNum = (n) => {
          const v = parseInt(n);
          if (!v) return '0';
          if (v >= 1e6) return (v/1e6).toFixed(1)+'M';
          if (v >= 1e3) return (v/1e3).toFixed(1)+'K';
          return v.toString();
        };
        let html = '<div class="cf-flow">';
        html += `<div class="cf-entry">${esc(this.fwChain.toUpperCase())} CHAIN</div>`;
        rules.forEach((r, i) => {
          const action = r.action || 'accept';
          const traffic = esc(fmtBytes(r.bytes) + ' / ' + fmtNum(r.packets) + ' pkts');
          const badges = [];
          if (r['src-address'] && r['src-address'] !== '0.0.0.0/0') badges.push({t:'from',v:esc(r['src-address']),c:'b-src'});
          if (r['dst-address'] && r['dst-address'] !== '0.0.0.0/0') badges.push({t:'to',v:esc(r['dst-address']),c:'b-dst'});
          if (r['in-interface'] && r['in-interface'] !== 'all') badges.push({t:'in',v:esc(r['in-interface']),c:'b-in'});
          if (r['out-interface'] && r['out-interface'] !== 'all') badges.push({t:'out',v:esc(r['out-interface']),c:'b-out'});
          if (r['connection-state'] && r['connection-state'] !== 'all') badges.push({t:'state',v:esc(r['connection-state']),c:'b-state'});
          if (r.protocol && r.protocol !== 'all') badges.push({t:esc(r.protocol),v:'',c:'b-proto'});
          const comment = r.comment ? esc(r.comment) : '';
          html += '<div class="cf-arrow-down"></div>';
          html += '<div class="cf-rule-row">';
          html += `<div class="cf-rule-card cf-${action}">`;
          html += `<div class="cf-rule-header"><span class="cf-rule-num">#${i+1}</span> <span class="cf-rule-action cf-${action}">${action}</span><span class="cf-traffic">${traffic}</span></div>`;
          if (badges.length || comment) {
            if (badges.length) {
              html += '<div class="cf-badges">';
              badges.forEach(b => {
                html += `<span class="cf-badge ${b.c}">${b.v ? b.t + ' ' + b.v : b.t}</span>`;
              });
              html += '</div>';
            }
            if (comment) html += `<div class="cf-comment">\u25b8 ${comment}</div>`;
          }
          html += '</div>';
          html += '</div>';
        });
        html += '<div class="cf-arrow-down"></div>';
        html += '<div class="cf-default">DEFAULT: accept</div>';
        html += '</div>';
        return html;
      },

      // --- Wireless ---
      async fetchWireless() {
        const hasData = this.wirelessInterfaces.length > 0;
        if (!hasData) { this.wirelessLoading = true; this.wirelessError = ''; }
        try {
          this.wirelessInterfaces = await this.apiFetch('/api/interface/wireless');
        } catch (err) {
          if (!hasData) { this.wirelessError = err.message || 'Unable to reach API'; }
        }
        if (!hasData) { this.wirelessLoading = false; }
      },

      // --- Utility ---
      formatUptime(seconds) {
        if (!seconds) return '--';
        const s = typeof seconds === 'string' ? parseDuration(seconds) : parseInt(seconds);
        if (isNaN(s)) return seconds;
        const d = Math.floor(s / 86400);
        const h = Math.floor((s % 86400) / 3600);
        const m = Math.floor((s % 3600) / 60);
        const parts = [];
        if (d) parts.push(d + 'd');
        if (h) parts.push(h + 'h');
        if (m || !parts.length) parts.push(m + 'm');
        return parts.join(' ');
      },

      formatBytes(bytes) {
        if (!bytes && bytes !== 0) return '--';
        const b = parseInt(bytes);
        if (isNaN(b)) return bytes;
        if (b === 0) return '0 B';
        const units = ['B', 'KB', 'MB', 'GB', 'TB'];
        const i = Math.floor(Math.log(b) / Math.log(1024));
        return (b / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
      },

      formatNumber(n) {
        if (!n && n !== 0) return '--';
        const num = parseInt(n);
        if (isNaN(num)) return n;
        if (num >= 1e9) return (num / 1e9).toFixed(1) + 'B';
        if (num >= 1e6) return (num / 1e6).toFixed(1) + 'M';
        if (num >= 1e3) return (num / 1e3).toFixed(1) + 'K';
        return num.toString();
      },
    };

    function parseDuration(str) {
      // Parse MikroTik duration format like "1w2d3h4m5s"
      if (!str) return NaN;
      let total = 0;
      const re = /(\d+)([wdhms])/g;
      let m;
      const mult = { w: 604800, d: 86400, h: 3600, m: 60, s: 1 };
      while ((m = re.exec(str)) !== null) {
        total += parseInt(m[1]) * (mult[m[2]] || 0);
      }
      return total > 0 ? total : NaN;
    }
  }
  </script>
</body>
</html>
